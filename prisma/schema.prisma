// Esquema Fase 01 — Fundaciones
// Diseñado con "bodega" como entidad desde el día uno: aunque la interfaz
// de la Fase 01 solo opera con una bodega por defecto, el modelo ya soporta
// múltiples ubicaciones y transferencias sin necesidad de migrar más adelante.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  VENTAS
  BODEGA
  COMPRAS
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
}

// Estados de una venta: Pendiente (recién creada, ya descontó stock) ->
// Pagada -> Entregada. Anulada revierte el stock descontado y congela
// la venta; solo se puede anular si todavía no fue entregada.
enum SaleStatus {
  PENDIENTE
  PAGADA
  ENTREGADA
  ANULADA
}

// Estados de una orden de compra: a diferencia de una venta, una compra NO
// afecta el stock al crearse — solo cuando se marca RECIBIDA (ahí se generan
// las entradas de stock). Anular revierte el stock si ya se había recibido.
enum PurchaseStatus {
  PENDIENTE
  RECIBIDA
  ANULADA
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           UserRole        @default(BODEGA)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  sales          Sale[]
  purchases      Purchase[]

  @@map("users")
}

model Warehouse {
  id          String          @id @default(cuid())
  name        String
  isDefault   Boolean         @default(false)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  stockLevels StockLevel[]
  movements   StockMovement[]
  sales       Sale[]
  purchases   Purchase[]

  @@map("warehouses")
}

// Ficha de cliente. Se guarda historial de compras a través de la
// relación con Sale (no se duplica nada de ahí, se consulta al vuelo).
model Customer {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@map("customers")
}

// Una venta descuenta stock automáticamente al crearse (un StockMovement
// SALIDA por cada línea, dentro de la misma transacción). Si se anula,
// se revierte con un StockMovement ENTRADA de vuelta.
model Sale {
  id          String          @id @default(cuid())
  number      Int             @unique @default(autoincrement())
  customer    Customer        @relation(fields: [customerId], references: [id])
  customerId  String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  warehouseId String
  status      SaleStatus      @default(PENDIENTE)
  totalAmount Decimal         @default(0) @db.Decimal(12, 2)
  notes       String?
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       SaleItem[]
  movements   StockMovement[]

  @@index([customerId])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id        String         @id @default(cuid())
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int
  unitPrice Decimal        @db.Decimal(12, 2)
  subtotal  Decimal        @db.Decimal(12, 2)

  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

// Ficha de proveedor. Igual que Customer, el historial de compras se
// consulta al vuelo a través de la relación con Purchase.
model Supplier {
  id        String     @id @default(cuid())
  name      String
  taxId     String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@map("suppliers")
}

// Una orden de compra NO descuenta ni agrega stock al crearse: queda en
// PENDIENTE hasta que se marca RECIBIDA, momento en que se genera un
// StockMovement ENTRADA por cada línea (dentro de la misma transacción).
// Si se anula después de recibida, se revierte esa entrada.
model Purchase {
  id          String          @id @default(cuid())
  number      Int             @unique @default(autoincrement())
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  supplierId  String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  warehouseId String
  status      PurchaseStatus  @default(PENDIENTE)
  totalAmount Decimal         @default(0) @db.Decimal(12, 2)
  notes       String?
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       PurchaseItem[]
  movements   StockMovement[]

  @@index([supplierId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  variantId  String
  quantity   Int
  unitCost   Decimal        @db.Decimal(12, 2)
  subtotal   Decimal        @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_items")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  description String?
  category    String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id                String          @id @default(cuid())
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  sku               String          @unique
  attributes        String?
  price             Decimal         @default(0) @db.Decimal(12, 2)
  cost              Decimal         @default(0) @db.Decimal(12, 2)
  lowStockThreshold Int             @default(5)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  stockLevels       StockLevel[]
  movements         StockMovement[]
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]

  @@index([productId])
  @@map("product_variants")
}

// Snapshot de stock actual por variante + bodega. Se recalcula de forma
// transaccional cada vez que se crea un StockMovement; StockMovement es
// la fuente de verdad (el historial nunca se edita ni se borra).
model StockLevel {
  id          String         @id @default(cuid())
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId   String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId String
  quantity    Int            @default(0)
  updatedAt   DateTime       @updatedAt

  @@unique([variantId, warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id          String         @id @default(cuid())
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  variantId   String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  warehouseId String
  type        MovementType
  quantity    Int
  reason      String?
  user        User           @relation(fields: [userId], references: [id])
  userId      String
  sale        Sale?          @relation(fields: [saleId], references: [id])
  saleId      String?
  purchase    Purchase?      @relation(fields: [purchaseId], references: [id])
  purchaseId  String?
  createdAt   DateTime       @default(now())

  @@index([variantId])
  @@index([warehouseId])
  @@index([saleId])
  @@index([purchaseId])
  @@index([createdAt])
  @@map("stock_movements")
}
