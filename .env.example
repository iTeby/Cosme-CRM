# Base de datos PostgreSQL
# Local: postgresql://usuario:password@localhost:5432/cosme_crm
# Producción (ej. Neon/Supabase): usa la cadena de conexión que te entreguen
DATABASE_URL="postgresql://cosme:cosme_dev_pw@localhost:5432/cosme_crm"

# NextAuth
# Genera un valor con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# --- Boleta electrónica (SII) ---
#
# TODO ESTO ES OPCIONAL. Sin nada configurado el sistema emite contra un
# proveedor simulado que no llama a nadie: sirve para ver la pantalla, no
# genera ningún documento y nada llega al SII.
#
# El ambiente por defecto es CERTIFICACION y la URL se deriva del ambiente,
# nunca se configura aparte: así no se puede quedar apuntando a producción
# con la etiqueta de certificación.
# DTE_ENVIRONMENT="CERTIFICACION"
#
# Para emitir folios REALES hacen falta las dos variables. Un "true" no
# habilita nada, a propósito: emitir una boleta real declara ante el SII una
# venta que puede no haber ocurrido, y eso solo se deshace con nota de
# crédito.
#
# La frase exacta NO está escrita acá a propósito: lleva dentro el RUT del
# emisor, así que no se puede copiar de ningún ejemplo. La forma está en
# src/lib/dte/config.ts, en la función frasePara().
# DTE_ENVIRONMENT="PRODUCCION"
# DTE_ALLOW_PRODUCCION="<la frase con tu RUT, ver frasePara() en src/lib/dte/config.ts>"

# Credencial de OpenFactura (Haulmer). Sin esto, proveedor simulado.
# OPENFACTURA_API_KEY=""
#
# El path de emisión no está en la documentación pública; hay que
# confirmarlo contra la cuenta antes de la primera emisión. Se puede
# corregir sin tocar código.
# OPENFACTURA_EMIT_PATH="/v2/dte/document"

# Datos del emisor, tal como están inscritos en el SII. Si falta alguno, el
# documento se rechaza después de haber consumido el folio.
# DTE_EMISOR_RUT=""
# DTE_EMISOR_RAZON_SOCIAL=""
# DTE_EMISOR_GIRO=""
# DTE_EMISOR_ACTECO=""
# DTE_EMISOR_DIRECCION=""
# DTE_EMISOR_COMUNA=""

# Integración con bandeja de WhatsApp (Worker cosme-whatsapp-bot)
# Debe coincidir con CRM_INTEGRATION_SECRET en Cloudflare
# WHATSAPP_INTEGRATION_SECRET=""
